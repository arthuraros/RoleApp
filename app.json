{
  "expo": {
    "name": "roleApp",
    "slug": "roleApp",
    "scheme": "roleapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.thekaiiros.roleApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#1D173F",
          "dark": {
            "image": "./assets/splash-logo.png",
            "backgroundColor": "#1D173F"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir que o RoleApp acesse sua localização para mostrar os locais favoritos no mapa."
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "bbecbeb8-bcaf-42b8-b1b3-f4f9d06a48eb"
      }
    }
  }
}
